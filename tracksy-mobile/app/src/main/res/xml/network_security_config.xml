<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP solo permitido hacia el emulador/localhost/LAN en desarrollo local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- IP de la PC en la red local, para probar desde un dispositivo físico -->
        <domain includeSubdomains="false">192.168.0.163</domain>
    </domain-config>
    <!-- Todo el resto requiere HTTPS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
